{
    "name": "wirecatllc/stripe_universal",
    "description": "Stripe Universal",
    "license": "MIT",
    "type": "blesta-gateway-nonmerchant",
    "require": {
        "php": ">=7.2",
        "blesta/composer-installer": "~1.0",
        "stripe/stripe-php": "~21.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload-dev": {
        "classmap": [
            "tests/Stubs/",
            "tests/MockHttpClient.php"
        ]
    },
    "config": {
        "platform": {
            "php": "7.4.0"
        },
        "allow-plugins": {
            "composer/installers": true,
            "blesta/composer-installer": true
        }
    }
}
