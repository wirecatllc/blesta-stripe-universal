{
    "name": "wirecatllc/stripe_universal",
    "description": "Stripe Universal",
    "license": "MIT",
    "type": "blesta-gateway-nonmerchant",
    "require": {
        "blesta/composer-installer": "~1.0",
        "stripe/stripe-php": "~14.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload-dev": {
        "classmap": [
            "tests/Stubs/",
            "tests/MockHttpClient.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "blesta/composer-installer": true
        }
    }
}
